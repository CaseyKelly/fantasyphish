{
  "name": "fantasyphish",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npx tsx scripts/migrate-deploy-with-lock-recovery.ts && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx scripts/seed-songs.ts",
    "db:sync-tours": "npx tsx scripts/sync-tours.ts",
    "db:sync-recent-songs": "npx tsx scripts/sync-recent-song-counts.ts",
    "db:restore-from-prod": "npx tsx scripts/restore-from-prod.ts",
    "db:branch": "npx tsx scripts/neon-branch.ts",
    "db:create-branch": "npx tsx scripts/neon-branch.ts create",
    "db:reset-branch": "npx tsx scripts/neon-branch.ts reset",
    "db:list-branches": "npx tsx scripts/neon-branch.ts list",
    "db:update-env": "npx tsx scripts/update-env-with-branch.ts",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:clean": "rm -rf test-results playwright-report",
    "test:trace": "./scripts/view-trace.sh",
    "watch:scoring": "npx tsx scripts/watch-scoring.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@serwist/turbopack": "^9.5.12",
    "@swc/helpers": "^0.5.17",
    "@vercel/analytics": "^1.6.1",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^0.577.0",
    "next": "16.3.0",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "serwist": "^9.5.12",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^5"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.24",
    "sharp": "0.35.3",
    "eslint-plugin-react-hooks": "7.0.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
