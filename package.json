{
  "name": "fantasyphish",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && npx tsx scripts/migrate-deploy-with-lock-recovery.ts && next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "npx tsx scripts/seed-songs.ts",
    "db:sync-tours": "npx tsx scripts/sync-tours.ts",
    "db:sync-recent-songs": "npx tsx scripts/sync-recent-song-counts.ts",
    "db:restore-from-prod": "npx tsx scripts/restore-from-prod.ts",
    "db:branch": "npx tsx scripts/neon-branch.ts",
    "db:create-branch": "npx tsx scripts/neon-branch.ts create",
    "db:reset-branch": "npx tsx scripts/neon-branch.ts reset",
    "db:list-branches": "npx tsx scripts/neon-branch.ts list",
    "db:update-env": "npx tsx scripts/update-env-with-branch.ts",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:coverage": "vitest run --coverage",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:clean": "rm -rf test-results playwright-report",
    "test:trace": "./scripts/view-trace.sh",
    "watch:scoring": "npx tsx scripts/watch-scoring.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.0.0",
    "@sentry/nextjs": "^10.69.0",
    "@serwist/turbopack": "^9.5.12",
    "@swc/helpers": "^0.5.17",
    "@vercel/analytics": "^2.0.0",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^3.0.3",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "lucide-react": "^1.0.0",
    "next": "16.3.4",
    "next-auth": "^5.0.0-beta.32",
    "pg": "^8.22.0",
    "prisma": "^7.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.18.1",
    "serwist": "^9.5.12",
    "sonner": "^2.0.7",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/pg": "^8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/web-push": "^3.6.4",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "minimatch": "10.2.6",
    "postcss": "8.5.26",
    "sharp": "0.35.4",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-jsx-a11y": {
      "minimatch": "^3.1.2"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "bash -c 'tsc --noEmit'"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  }
}
